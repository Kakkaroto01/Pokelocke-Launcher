<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- El proyecto de tests necesita xunit/Test.Sdk desde nuget.org; el NuGet.Config de src\
       desactiva los orígenes remotos para compilar sin red. Este lo re-habilita solo aquí. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
