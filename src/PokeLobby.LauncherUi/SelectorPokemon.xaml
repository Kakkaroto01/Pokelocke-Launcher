<Window x:Class="PokeLobby.LauncherUi.SelectorPokemon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elegir Pokémon" Height="760" Width="1020"
        Background="{DynamicResource ColorFondo}"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">

    <Border Margin="16" Background="{DynamicResource ColorPanel}" CornerRadius="12" Padding="16"
            BorderBrush="{DynamicResource ColorBorde}" BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="TxtTitulo" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource AcentoBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtSubtitulo" Margin="0,2,0,10" FontSize="11.5"
                           Foreground="{DynamicResource ColorTextoSuave}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock x:Name="TxtSeleccion" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource ColorTextoSuave}"/>
                <Button Content="Cancelar" Padding="18,8" Margin="0,0,10,0" Click="Cancelar_Click"/>
                <Button x:Name="BtnAceptar" Content="Elegir" Style="{StaticResource BotonAcento}"
                        Padding="22,8" IsEnabled="False" Click="Aceptar_Click"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="EQUIPO" Style="{StaticResource TituloSeccion}"/>
                    <UniformGrid x:Name="GridEquipo" Columns="6" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                        <TextBlock Text="CAJAS" Style="{StaticResource TituloSeccion}" Margin="0"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbCaja" Width="260" Margin="16,0,0,0"
                                  SelectionChanged="CmbCaja_SelectionChanged"/>
                        <TextBlock x:Name="TxtInfoCaja" Margin="14,0,0,0" VerticalAlignment="Center"
                                   FontSize="11.5" Foreground="{DynamicResource ColorTextoSuave}"/>
                    </StackPanel>
                    <UniformGrid x:Name="GridCaja" Columns="6" Margin="0,0,0,8"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
