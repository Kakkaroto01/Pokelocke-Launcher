<Window x:Class="PokeLobby.LauncherUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes y personalización" Height="760" Width="860"
        Background="{DynamicResource ColorFondo}"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">

    <Border Margin="16" Background="{DynamicResource ColorPanel}" CornerRadius="12" Padding="18"
            BorderBrush="{DynamicResource ColorBorde}" BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Ajustes y personalización" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource AcentoBrush}"/>
                <TextBlock Margin="0,2,0,10" TextWrapping="Wrap"
                           Text="Tema de acento, fondo (color/imagen/vídeo), sonidos y emuladores."
                           Foreground="{DynamicResource ColorTextoSuave}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cerrar" Padding="18,8" Click="Cerrar_Click"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- ══ Tema de acento (16) ══ -->
                    <Expander Header="Tema de acento (16 presets)" IsExpanded="True" Margin="0,0,0,8"
                              Foreground="{DynamicResource ColorTexto}" FontWeight="SemiBold">
                        <StackPanel Margin="12,8,0,8">
                            <WrapPanel x:Name="PanelAcentos"/>
                            <TextBlock Text="Se aplica al instante y se guarda al cerrar."
                                       Foreground="{DynamicResource ColorTextoSuave}" FontSize="11.5" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Expander>

                    <!-- ══ Fondo (8 colores + imagen/vídeo) ══ -->
                    <Expander Header="Fondo (color, imagen o vídeo)" IsExpanded="True" Margin="0,0,0,8"
                              Foreground="{DynamicResource ColorTexto}" FontWeight="SemiBold">
                        <StackPanel Margin="12,8,0,8">
                            <WrapPanel x:Name="PanelFondos"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Elegir imagen/vídeo…" Padding="12,6" Click="ElegirFondo_Click"/>
                                <Button Content="Quitar fondo" Margin="8,0,0,0" Padding="12,6" Click="QuitarFondo_Click"/>
                                <TextBlock x:Name="TxtFondoEstado" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{DynamicResource ColorTextoSuave}"/>
                            </StackPanel>
                            <StackPanel x:Name="PanelAudioVideo" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                <CheckBox x:Name="ChkSonidoVideo" Content="Vídeo con sonido" VerticalAlignment="Center"
                                          Checked="AudioVideo_Changed" Unchecked="AudioVideo_Changed"/>
                                <TextBlock Text="Volumen:" VerticalAlignment="Center" Margin="18,0,8,0"
                                           Foreground="{DynamicResource ColorTextoSuave}"/>
                                <Slider x:Name="SldVolumen" Width="180" Minimum="0" Maximum="100"
                                        VerticalAlignment="Center" ValueChanged="Volumen_Changed"/>
                                <TextBlock x:Name="TxtVolumen" VerticalAlignment="Center" Margin="8,0,0,0" Width="46"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- ══ Sonidos ══ -->
                    <Expander Header="Sonidos de la interfaz" Margin="0,0,0,8"
                              Foreground="{DynamicResource ColorTexto}" FontWeight="SemiBold">
                        <StackPanel Margin="12,8,0,8">
                            <CheckBox x:Name="ChkSonidos" Content="Sonidos al pasar/pulsar la navegación"
                                      Checked="Sonidos_Changed" Unchecked="Sonidos_Changed"/>
                        </StackPanel>
                    </Expander>

                    <!-- ══ Emulador de Switch ══ -->
                    <Expander Header="Emulador de Switch (ejecutable y argumentos)" IsExpanded="True" Margin="0,0,0,8"
                              Foreground="{DynamicResource ColorTexto}" FontWeight="SemiBold">
                        <StackPanel Margin="12,8,0,8">
                            <TextBlock Text="Ejecutable del emulador" Foreground="{DynamicResource ColorTextoSuave}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSwitchExe" Grid.Column="0" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="Elegir .exe…" Margin="8,0,0,0" Padding="12,6" Click="ElegirSwitch_Click"/>
                                <Button Grid.Column="2" Content="Quitar" Margin="8,0,0,0" Padding="12,6" Click="QuitarSwitch_Click"/>
                            </Grid>
                            <TextBlock Text="Argumentos ({rom} se sustituye por la ROM entrecomillada)"
                                       Foreground="{DynamicResource ColorTextoSuave}" Margin="0,10,0,0"/>
                            <TextBox x:Name="TxtSwitchArgs" Margin="0,4,0,0" LostFocus="SwitchArgs_LostFocus"/>
                            <TextBlock x:Name="TxtSwitchAviso" Foreground="#FFA726" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Expander>

                    <!-- ══ Carpetas y Firebase ══ -->
                    <Expander Header="Carpetas y conexión" Margin="0,0,0,8"
                              Foreground="{DynamicResource ColorTexto}" FontWeight="SemiBold">
                        <StackPanel Margin="12,8,0,8">
                            <TextBlock Text="Carpeta vendor (emuladores/JRE/randomizer)" Foreground="{DynamicResource ColorTextoSuave}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtVendor" Grid.Column="0"/>
                                <Button Grid.Column="1" Content="Elegir…" Margin="8,0,0,0" Padding="12,6" Click="ElegirVendor_Click"/>
                            </Grid>
                            <TextBlock Text="Carpeta de datos (library.json, huellas.json…)" Foreground="{DynamicResource ColorTextoSuave}" Margin="0,10,0,0"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtDatos" Grid.Column="0"/>
                                <Button Grid.Column="1" Content="Elegir…" Margin="8,0,0,0" Padding="12,6" Click="ElegirDatos_Click"/>
                            </Grid>
                            <TextBlock Text="Firebase RTDB — URL" Foreground="{DynamicResource ColorTextoSuave}" Margin="0,10,0,0"/>
                            <TextBox x:Name="TxtFirebaseUrl" Margin="0,4,0,0"/>
                            <TextBlock Text="Firebase — Web API Key" Foreground="{DynamicResource ColorTextoSuave}" Margin="0,10,0,0"/>
                            <TextBox x:Name="TxtFirebaseKey" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
