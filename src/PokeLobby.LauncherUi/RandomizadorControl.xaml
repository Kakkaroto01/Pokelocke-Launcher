<UserControl x:Class="PokeLobby.LauncherUi.RandomizadorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ Header estilo Pokelobby ═══════════ -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="20,20,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Randomizador" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource ColorTexto}" VerticalAlignment="Center"/>
                    <Border Width="1" Height="24" Margin="12,0,12,0" Background="{DynamicResource ColorBorde}"/>
                    <TextBlock Text="Configura y randomiza una ROM con precisión." FontSize="13"
                               Foreground="{DynamicResource ColorTextoSuave}" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button x:Name="BtnAyuda" Content="?" Grid.Column="1" Width="32" Height="32"
                        Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderBrush="{DynamicResource ColorBorde}"
                        Foreground="{DynamicResource ColorTextoSuave}" FontSize="14" FontWeight="Bold"
                        Cursor="Hand" Click="BtnAyuda_Click"/>
            </Grid>
        </Border>

        <!-- ═══════════ Cuerpo con scroll ═══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="20,0,20,24">

            <StackPanel>

                <!-- ══ Card: ROM y preset ══ -->
                <Border Style="{StaticResource Tarjeta}" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="ROM" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorTextoSuave}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtRom" IsReadOnly="True" Padding="10,8" FontSize="14"
                                     ToolTip="ROM a randomizar"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Examinar…" Padding="16,10" FontSize="13"
                                Margin="0,0,12,0" Click="ElegirRom_Click"
                                Style="{StaticResource BotonAcento}"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="200">
                            <TextBlock Text="Preset" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorTextoSuave}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbPresetVendor" Padding="10,8" FontSize="14"
                                      ToolTip="Presets del propio motor (vendor/SuperRandomizer/presets)"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Botones de archivo rápidos -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="📁 Cargar .rnqs…" Padding="12,8" FontSize="12"
                            Click="CargarArchivo_Click" Margin="0,0,8,0"/>
                    <Button Content="💾 Guardar .rnqs…" Padding="12,8" FontSize="12"
                            Click="GuardarArchivo_Click" Margin="0,0,8,0"/>
                    <Button Content="💾 Guardar preset propio…" Padding="12,8" FontSize="12"
                            Click="GuardarPresetPropio_Click" Margin="0,0,8,0"/>
                    <Button Content="🔄 Restablecer todo" Padding="12,8" FontSize="12"
                            Click="Restablecer_Click"/>
                </StackPanel>

                <!-- ══ Estado (mensaje simple) ══ -->
                <Border Style="{StaticResource Tarjeta}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Estado" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorTextoSuave}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtEstado" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorTextoSuave}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- ══ Pestañas de características (estilo Pokelobby) ══ -->
                <Border Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,16">
                    <TabControl x:Name="TabsCategorias" SelectedIndex="0"
                                SelectionChanged="TabsCategorias_SelectionChanged"
                                Background="Transparent" BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="Foreground" Value="{DynamicResource ColorTextoSuave}"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="16,12"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Borde" Background="Transparent"
                                                    BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                                    CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter x:Name="Contenido"
                                                                  ContentSource="Header"
                                                                  RecognizesAccessKey="True"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Borde" Property="BorderBrush"
                                                            Value="{DynamicResource AcentoBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Borde" Property="Background"
                                                            Value="{DynamicResource ColorPanelVelo}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        <!-- Las pestañas se llenan desde code-behind -->
                    </TabControl>
                </Border>

                <!-- ══ Panel de opciones ══ -->
                <Border x:Name="BorderOpciones" Style="{StaticResource Tarjeta}" Padding="24">
                    <StackPanel x:Name="PanelOpciones"/>
                </Border>

                <!-- ══ Botones inferiores estilo Pokelobby ══ -->
                <Border Margin="0,24,0,0" Padding="20,24,20,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnRandomizar" Content="🎲  Randomizar ROM"
                                Style="{StaticResource BotonAcento}" Padding="24,14" FontSize="15" FontWeight="SemiBold"
                                Margin="0,0,12,0" Width="210" Click="Randomizar_Click"/>
                        <Button x:Name="BtnGuardarPresetYRandomizar" Content="💾  Guardar preset y randomizar"
                                Style="{StaticResource BotonAcento}" Padding="24,14" FontSize="15" FontWeight="SemiBold"
                                Margin="0,0,12,0" Width="280" Click="GuardarPresetYRandomizar_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
