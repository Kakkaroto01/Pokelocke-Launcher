<UserControl x:Class="PokeLobby.LauncherUi.RandomizadorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ Header estilo Rediseño ═══════════ -->
        <Border Grid.Row="0" Padding="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Randomizador" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorTexto}"/>
                <TextBlock Text="Configura las reglas por categoría, guarda presets y genera una ROM randomizada"
                           FontSize="12.5" Foreground="{DynamicResource ColorTextoSuave}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ Cuerpo con scroll ═══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="0,0,0,12">

                <!-- ══ ROM Selection & Preset Bar ══ -->
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16" CornerRadius="12" BorderThickness="1">
                    <StackPanel Margin="20">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Archivo de ROM base" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorTextoSuave}" Margin="0,0,0,6"/>
                                <DockPanel LastChildFill="True">
                                    <Button Grid.Column="1" Content="Examinar…" Padding="12,8" FontSize="12"
                                            Margin="8,0,0,0" Click="ElegirRom_Click"
                                            Style="{StaticResource BotonNav}"
                                            DockPanel.Dock="Right"/>
                                    <TextBox x:Name="TxtRom" IsReadOnly="True" Padding="10,8" FontSize="13"
                                             FontFamily="Consolas" TextWrapping="NoWrap"
                                             ToolTip="ROM a randomizar"/>
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" MinWidth="180">
                                <TextBlock Text="Preset activo" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorTextoSuave}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbPresetVendor" Padding="10,8" FontSize="13"
                                          ToolTip="Presets del propio motor (vendor/SuperRandomizer/presets)"/>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="0,1,0,0"
                                Margin="0,16,0,0" Padding="0,16,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="📁  Cargar .rnqs…" Padding="10,8" FontSize="12"
                                        Click="CargarArchivo_Click" Margin="0,0,10,0"/>
                                <Button Content="💾  Guardar .rnqs…" Padding="10,8" FontSize="12"
                                        Click="GuardarArchivo_Click" Margin="0,0,10,0"/>
                                <Button Content="💾  Guardar preset propio…" Padding="10,8" FontSize="12"
                                        Click="GuardarPresetPropio_Click" Margin="0,0,10,0"/>
                                <Button Content="🔄  Restablecer todo" Padding="10,8" FontSize="12"
                                        Click="Restablecer_Click"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Span FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ColorOk}">
                                <Run Text="●  "/>
                                <Run x:Name="TxtCompatRom" Text="ROM compatible · Gen IV (NDS)"/>
                            </Span>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ Category Tabs ══ -->
                <Border Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="BtnTabCaracteristicas" Content="Características" Tag="tab-caracteristicas"
                                Style="{StaticResource BotonCategoria}" Click="TabCategoria_Click"/>
                        <Button x:Name="BtnTabIniciales" Content="Iniciales y Estáticos" Tag="tab-iniciales"
                                Style="{StaticResource BotonCategoria}" Click="TabCategoria_Click"/>
                        <Button x:Name="BtnTabMovimientos" Content="Movimientos" Tag="tab-movimientos"
                                Style="{StaticResource BotonCategoria}" Click="TabCategoria_Click"/>
                        <Button x:Name="BtnTabSalvajes" Content="Pokémon Salvajes" Tag="tab-salvajes"
                                Style="{StaticResource BotonCategoria}" Click="TabCategoria_Click"/>
                        <Button x:Name="BtnTabEntrenadores" Content="Entrenadores" Tag="tab-entrenadores"
                                Style="{StaticResource BotonCategoria}" Click="TabCategoria_Click"/>
                        <Button x:Name="BtnTabObjetos" Content="Objetos" Tag="tab-objetos"
                                Style="{StaticResource BotonCategoria}" Click="TabCategoria_Click"/>
                        <Button x:Name="BtnTabMiscelanea" Content="Miscelánea" Tag="tab-miscelanea"
                                Style="{StaticResource BotonCategoria}" Click="TabCategoria_Click"/>
                    </StackPanel>
                </Border>

                <!-- ══ Panel de opciones (una tarjeta por subcategoría) ══ -->
                <Border x:Name="BorderOpciones" Style="{StaticResource Tarjeta}" Padding="0" Margin="0,0,0,0"
                        CornerRadius="12" BorderThickness="1">
                    <StackPanel x:Name="PanelOpciones"/>
                </Border>

                <!-- ══ Botones inferiores estilo Rediseño ══ -->
                <Border Margin="0,20,0,0" Padding="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnGuardarPreset" Content="💾  Guardar preset"
                                Style="{StaticResource BotonNav}" Padding="16,10" FontSize="13"
                                Margin="0,0,12,0" Click="GuardarPreset_Click"/>
                        <Button x:Name="BtnRandomizar" Content="🎲  Randomizar ROM"
                                Style="{StaticResource BotonAcento}" Padding="20,12" FontSize="14" FontWeight="SemiBold"
                                Margin="0,0,0,0" Click="Randomizar_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
