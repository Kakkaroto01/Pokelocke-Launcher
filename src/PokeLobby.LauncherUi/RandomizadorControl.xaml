<UserControl x:Class="PokeLobby.LauncherUi.RandomizadorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="BtnRandoPrimario" TargetType="Button">
            <Setter Property="Background" Value="#B92318"/>
            <Setter Property="BorderBrush" Value="#D93829"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D02B1E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#9E1D13"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnRandoSecundario" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ColorPanelContainerHigh}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBordeVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ColorPanelContainerHighest}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnRandoCompacto" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ColorPanelContainerLow}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBordeVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ColorPanelContainerHigh}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnRandoSutil" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextoSuave}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ColorPanelContainerLow}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabRando" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextoSuave}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="activo">
                                <Setter TargetName="TabBg" Property="Background" Value="{DynamicResource ColorPanelContainerHigh}"/>
                                <Setter TargetName="TabBg" Property="BorderBrush" Value="{DynamicResource AcentoBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio pill estilo Rediseño -->
        <Style x:Key="RadioPillRando" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ColorTextoSuave}"/>
            <Setter Property="Background" Value="{DynamicResource ColorPanelContainerLow}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBordeVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="OuterCircle" Stroke="#5A5E6B" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Ellipse x:Name="InnerDot" Width="7" Height="7" Fill="#FFFFFF" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBg" Property="Background" Value="{DynamicResource ColorPanelContainerHigh}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBg" Property="BorderBrush" Value="{DynamicResource AcentoBrush}"/>
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#FF5541"/>
                                <Setter TargetName="OuterCircle" Property="Fill" Value="#FF5541"/>
                                <Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox circular estilo Rediseño -->
        <Style x:Key="CheckCircularRando" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ColorTextoSuave}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Box" Stroke="#5A5E6B" StrokeThickness="1.5" Fill="Transparent"/>
                                <Path x:Name="CheckMark" Data="M3.5,8.5 L6.5,11.5 L12.5,4.5"
                                      Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Fill" Value="#FF5541"/>
                                <Setter TargetName="Box" Property="Stroke" Value="#FF5541"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputRando" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource ColorPanelContainerLow}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBordeVariant}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <!-- Slider estilo Rediseño (pista roja/oscura + thumb circular blanco con borde rojo) -->
        <Style x:Key="SliderRando" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#2C303C" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#FF5541" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#FF5541" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ Barra superior con acciones principales ═══════════ -->
        <Border Grid.Row="0" Padding="0,4,0,16" BorderBrush="{DynamicResource ColorBordeVariant}"
                BorderThickness="0,0,0,1" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Configura las reglas por categoría, guarda presets y genera una ROM randomizada"
                           FontSize="12.5" Foreground="{DynamicResource ColorTextoSuave}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="BtnGuardarPreset" Style="{StaticResource BtnRandoSecundario}"
                            Padding="14,10" Margin="0,0,10,0" Click="GuardarPreset_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource ColorTexto}"
                                          Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Guardar preset" Foreground="{DynamicResource ColorTexto}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRandomizar" Style="{StaticResource BtnRandoPrimario}"
                            Padding="18,10" Click="Randomizar_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#FFFFFF"
                                          Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM7.5 18c-.83 0-1.5-.67-1.5-1.5S6.67 15 7.5 15s1.5.67 1.5 1.5S8.33 18 7.5 18zm0-9C6.67 9 6 8.33 6 7.5S6.67 6 7.5 6 9 6.67 9 7.5 8.33 9 7.5 9zm4.5 4.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4.5 4.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm0-9c-.83 0-1.5-.67-1.5-1.5S15.67 6 16.5 6 18 6.67 18 7.5 17.33 9 16.5 9z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Randomizar ROM" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Cuerpo con scroll ═══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,16" MaxWidth="1120">

                <!-- ══ Selección de ROM y Preset ══ -->
                <Border Background="{DynamicResource ColorPanelContainer}"
                        BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                        CornerRadius="12" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Archivo de ROM base" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorTexto}" Margin="0,0,0,6"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnRandoSecundario}"
                                            Padding="14,9" Margin="8,0,0,0" Click="ElegirRom_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="{DynamicResource ColorTexto}"
                                                          Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Examinar" Foreground="{DynamicResource ColorTexto}"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBox x:Name="TxtRom" IsReadOnly="True" Style="{StaticResource InputRando}"
                                             TextWrapping="NoWrap" ToolTip="ROM a randomizar"/>
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <TextBlock Text="Preset activo" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorTexto}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbPresetVendor" Padding="12,9" FontSize="13" MinHeight="38"
                                          ToolTip="Presets del propio motor (vendor/SuperRandomizer/presets)"/>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="0,1,0,0"
                                Margin="0,16,0,0" Padding="0,14,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource ColorTextoSuave}" VerticalAlignment="Center">
                                    <Run x:Name="TxtCompatRom" Text="Sin ROM seleccionada"/>
                                </TextBlock>

                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnRandoCompacto}" Padding="12,7"
                                            Click="CargarArchivo_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="{DynamicResource ColorTexto}"
                                                          Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15.01l1.41 1.41L11 14.84V19h2v-4.16l1.59 1.59L16 15.01 12.01 11z"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Cargar .rnqs" Foreground="{DynamicResource ColorTexto}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource BtnRandoCompacto}" Padding="12,7"
                                            Click="GuardarArchivo_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="{DynamicResource ColorTexto}"
                                                          Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Exportar .rnqs" Foreground="{DynamicResource ColorTexto}"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource BtnRandoSutil}" Padding="10,7"
                                            Click="Restablecer_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="{DynamicResource ColorTextoSuave}"
                                                          Data="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Restablecer todo"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ Pestañas de categorías (barra oscura con desplazamiento horizontal) ══ -->
                <Border Background="{DynamicResource ColorPanelContainerLow}"
                        BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                        CornerRadius="10" Padding="6" Margin="0,0,0,18">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnTabCaracteristicas" Content="Características" Tag="tab-caracteristicas"
                                    Style="{StaticResource TabRando}" Click="TabCategoria_Click"/>
                            <Button x:Name="BtnTabIniciales" Content="Iniciales y Estáticos" Tag="tab-iniciales"
                                    Style="{StaticResource TabRando}" Click="TabCategoria_Click"/>
                            <Button x:Name="BtnTabMovimientos" Content="Movimientos" Tag="tab-movimientos"
                                    Style="{StaticResource TabRando}" Click="TabCategoria_Click"/>
                            <Button x:Name="BtnTabSalvajes" Content="Pokémon Salvajes" Tag="tab-salvajes"
                                    Style="{StaticResource TabRando}" Click="TabCategoria_Click"/>
                            <Button x:Name="BtnTabEntrenadores" Content="Entrenadores" Tag="tab-entrenadores"
                                    Style="{StaticResource TabRando}" Click="TabCategoria_Click"/>
                            <Button x:Name="BtnTabObjetos" Content="Objetos" Tag="tab-objetos"
                                    Style="{StaticResource TabRando}" Click="TabCategoria_Click"/>
                            <Button x:Name="BtnTabMiscelanea" Content="Miscelánea" Tag="tab-miscelanea"
                                    Style="{StaticResource TabRando}" Click="TabCategoria_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ══ Contenedor de tarjetas de subcategoría (2 columnas) ══ -->
                <Border x:Name="BorderOpciones" Background="Transparent" BorderThickness="0" Padding="0">
                    <StackPanel x:Name="PanelOpciones"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
