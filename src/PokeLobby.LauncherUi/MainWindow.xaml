<Window x:Class="PokeLobby.LauncherUi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PokeLobby.LauncherUi"
        Title="PokeLocke Launcher" Height="820" Width="1280"
        Background="{DynamicResource ColorFondo}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Icon="pack://application:,,,/PokeLockeLauncher;component/pokelocke.png">

    <Grid>
        <!-- Fondo personalizado (imagen) + velo -->
        <Image Source="{DynamicResource FondoAppImagen}" Stretch="UniformToFill"/>
        <Rectangle Fill="{DynamicResource FondoVeloBrush}"/>
        <MediaElement x:Name="FondoVideo" Stretch="UniformToFill" LoadedBehavior="Manual"
                      UnloadedBehavior="Manual" MediaEnded="FondoVideo_MediaEnded"
                      MediaFailed="FondoVideo_MediaFailed" Visibility="Collapsed"/>
        <Rectangle Fill="{DynamicResource FondoVeloBrush}"/>

        <DockPanel LastChildFill="True">
            <!-- ═══════════ Sidebar persistente (desktop) ═══════════ -->
            <Border DockPanel.Dock="Left" Width="252" Background="{DynamicResource ColorPanelContainerLowest}"
                    BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="0,0,1,0"
                    Padding="12,14">
                <DockPanel LastChildFill="True">
                    <!-- Encabezado de marca -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="#F5F5F5" Stroke="#20202E" StrokeThickness="2"/>
                                <Path Data="M1,17 A16,16 0 0 1 33,17 L1,17 Z" Fill="{DynamicResource AcentoBrush}"/>
                                <Rectangle Height="3" Fill="#20202E" VerticalAlignment="Center"/>
                                <Ellipse Width="10" Height="10" Fill="White" Stroke="#20202E" StrokeThickness="2"/>
                            </Grid>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PokeLocke" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorTexto}"/>
                                <TextBlock Text="Launcher v1.0.0" FontSize="10.5"
                                           Foreground="{DynamicResource ColorTextoSuave}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navegación principal -->
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button x:Name="BtnNavInicio" Content="🏠   Inicio" Tag="activo"
                                    Style="{StaticResource BotonNav}" Click="Nav_Click"/>
                            <Button x:Name="BtnNavBiblioteca" Content="📚   Biblioteca"
                                    Style="{StaticResource BotonNav}" Click="BtnNavBiblioteca_Click"/>
                            <Button x:Name="BtnNavLocke" Content="🔒   Locke en vivo"
                                    Style="{StaticResource BotonNav}" Click="Nav_Click"/>
                            <Button x:Name="BtnNavRandomizar" Content="🎲   Randomizador"
                                    Style="{StaticResource BotonNav}" Click="BtnNavRandomizar_Click"/>
                            <Button x:Name="BtnNavAjustes" Content="⚙   Ajustes"
                                    Style="{StaticResource BotonNav}" Click="BtnAjustes_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Acciones rápidas (Añadir ROM, Carpeta de datos) -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ColorPanelContainerLow}"
                            BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="0,1,0,0"
                            Padding="8,12" CornerRadius="8">
                        <StackPanel>
                            <Button x:Name="BtnAnadirRom" Content="➕  Añadir ROM"
                                    Style="{StaticResource BotonAcento}" Padding="12,8"
                                    Click="BtnAnadirRom_Click" Margin="0,0,0,8"/>
                            <Button x:Name="BtnAbrirBiblioteca" Content="📂  Carpeta de datos"
                                    Style="{StaticResource BotonNav}" Padding="10,6" FontSize="12"
                                    Click="BtnAbrirBiblioteca_Click" Margin="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Panel de cuenta Firebase (abajo) -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ColorPanelContainerLow}"
                            BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="0,1,0,0"
                            Padding="10,10" CornerRadius="10" VerticalAlignment="Bottom">
                        <StackPanel>
                            <TextBlock Text="Firebase conectado" FontSize="10.5"
                                       Foreground="{DynamicResource ColorOk}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtCuenta" Text="Sin cuenta" FontSize="12"
                                       Foreground="{DynamicResource ColorTexto}" FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <Button x:Name="BtnCuenta" Content="Iniciar sesión" Margin="0" Padding="10,6"
                                    FontSize="12" Click="BtnCuenta_Click"
                                    Style="{StaticResource BotonAcento}"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ═══════════ Área de contenido principal ═══════════ -->
            <DockPanel LastChildFill="True">
                <!-- Cabecera superior -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource ColorFondo}"
                        BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtTituloSeccion" Text="Inicio" FontSize="22"
                                       FontWeight="SemiBold" Foreground="{DynamicResource ColorTexto}"/>
                            <TextBlock x:Name="TxtSubtituloSeccion" Text="" FontSize="11.5"
                                       Foreground="{DynamicResource ColorTextoSuave}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtEstadoConexion" Text="● Conectado" FontSize="11"
                                       Foreground="{DynamicResource ColorOk}" Margin="0,0,12,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido scrollable -->
                <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,16">
                    <Grid>
                        <!-- ─── PÁGINA: INICIO ─── -->
                        <ScrollViewer x:Name="PanelInicio" VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,0,0" Visibility="Visible">
                            <StackPanel Margin="0,12,0,0">

                                <!-- Hero: Última partida -->
                                <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16"
                                        CornerRadius="12" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="24">

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <TextBlock Text="ÚLTIMA PARTIDA" FontSize="10.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource AcentoBrush}"
                                                           Margin="0,0,8,0"/>
                                                <Border Width="7" Height="7" CornerRadius="4"
                                                      Background="{DynamicResource ColorOk}"
                                                      Margin="0,3,0,0"/>
                                                <TextBlock Text="DS · 2026-11-24 23:20" FontSize="10.5"
                                                           Foreground="{DynamicResource ColorTextoSuave}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Text="Pokémon HeartGold" FontSize="22"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource ColorTexto}"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="Pokemon HeartGold_randomized_20261117-004448.nds"
                                                       FontSize="11" Foreground="{DynamicResource ColorTextoSuave}"
                                                       Margin="0,0,0,12"/>

                                            <TextBlock Text="Al iniciar se aplicarán automáticamente los objetos y cartas pendientes de tu sala en Pokelocke sobre el archivo de guardado."
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ColorTextoSuave}"
                                                       Margin="0,0,0,16"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                <Button x:Name="BtnJugarUltima" Content="▶  Continuar Partida"
                                                        Style="{StaticResource BotonAcento}" Padding="16,10"
                                                        FontSize="13" FontWeight="SemiBold"
                                                        Click="BtnJugarUltima_Click" Margin="0,0,10,0"
                                                        HorizontalAlignment="Left"/>
                                                <Button Content="🔄  Aplicar cambios al .sav"
                                                        Style="{StaticResource BotonNav}" Padding="12,8"
                                                        FontSize="12" Margin="0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Portada real del juego a la derecha -->
                                        <Border Grid.Column="1" Margin="16,16,16,16"
                                                BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                                CornerRadius="10">
                                            <Image x:Name="ImgPortadaHero" Stretch="UniformToFill"
                                                   Margin="0"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Split: Biblioteca reciente + Locke en vivo -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="340"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Biblioteca reciente -->
                                    <Border Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="BIBLIOTECA RECIENTE" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource ColorTexto}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="Ver todas" FontSize="11"
                                                           Foreground="{DynamicResource AcentoBrush}"
                                                           Cursor="Hand" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="2 ROMs registradas en tu equipo" FontSize="10"
                                                       Foreground="{DynamicResource ColorTextoSuave}"
                                                       Margin="0,6,0,14"/>

                                            <!-- ROM reciente 1 -->
                                            <Border Background="{DynamicResource ColorPanelContainer}"
                                                    BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                                    CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="44" Height="44" CornerRadius="8"
                                                            Background="#0B0F17" Margin="0,0,10,0">
                                                        <Image x:Name="ImgCoverReciente1" Stretch="UniformToFill"
                                                               Margin="2"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                        <TextBlock Text="Pokémon HeartGold Random"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ColorTexto}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Width="7" Height="7" CornerRadius="4"
                                                                  Background="#0B0F17" Margin="0,2,6,0"/>
                                                            <TextBlock Text="DS · Sala 607 · e4locke"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock Text="11 Oct" FontSize="10"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        <TextBlock Text="14:04" FontSize="10"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- ROM reciente 2 -->
                                            <Border Background="{DynamicResource ColorPanelContainer}"
                                                    BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                                    CornerRadius="10" Padding="14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="44" Height="44" CornerRadius="8"
                                                            Background="#0B0F17" Margin="0,0,10,0">
                                                        <Image x:Name="ImgCoverReciente2" Stretch="UniformToFill"
                                                               Margin="2"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                        <TextBlock Text="Pokemon Esmeralda Kaizo"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ColorTexto}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Width="7" Height="7" CornerRadius="4"
                                                                  Background="#0B0F17" Margin="0,2,6,0"/>
                                                            <TextBlock Text="GBA · Sin locke vinculado"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock Text="24 Nov" FontSize="10"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        <TextBlock Text="23:20" FontSize="10"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Locke en vivo -->
                                    <Border Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="LOCKE EN VIVO" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource ColorTexto}"/>
                                                <Border DockPanel.Dock="Right" Background="{DynamicResource ColorOk}"
                                                        Width="7" Height="7" CornerRadius="4"
                                                        Margin="0,4,0,0"/>
                                            </DockPanel>
                                            <TextBlock Text="Sincronización con Pokelocke Android"
                                                       FontSize="10" Foreground="{DynamicResource ColorTextoSuave}"
                                                       Margin="0,6,0,14"/>

                                            <Border Background="{DynamicResource ColorPanelContainerLow}"
                                                    BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                                    CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="Locke activo" FontSize="10"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        <TextBlock Text="Hardlocke (Sala 607)"
                                                                   FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ColorTexto}"
                                                                   Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="Archivo .sav" FontSize="10"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        <TextBlock Text="HeartGold.dav"
                                                                   FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ColorTexto}"
                                                                   Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="Cambios pendientes" FontSize="10"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        <TextBlock Text="2 objetos"
                                                                   FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AcentoBrush}"
                                                                   Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Button Content="📤  Publicar equipo"
                                                        Style="{StaticResource BotonNav}" Padding="12,8"
                                                        FontSize="12" Click="BtnPublicarEquipo_Click"
                                                        HorizontalAlignment="Left" Margin="0,0,8,0"/>
                                                <Button Content="Abrir panel"
                                                        Style="{StaticResource BotonNav}" Padding="12,8"
                                                        FontSize="12" Click="BtnAbrirPanelLocke_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Registro -->
                                <Border Style="{StaticResource Tarjeta}" Margin="0,16,0,0"
                                        CornerRadius="12" BorderThickness="1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                    Margin="20,20,20,12">
                                            <TextBlock Text="REGISTRO" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ColorTextoSuave}"/>
                                            <Button Content="Limpiar" Margin="12,0,0,0" Padding="8,4"
                                                    FontSize="11" Click="BtnLimpiarLog_Click"
                                                    Style="{StaticResource BotonNav}"/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas"
                                                 FontSize="11.5" Height="150" VerticalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap" Background="Transparent"
                                                 BorderThickness="0" Margin="20,0,20,20"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ─── PÁGINA: LOCKE EN VIVO ─── -->
                        <ScrollViewer x:Name="PanelLocke" VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,0,0" Visibility="Collapsed">
                            <StackPanel Margin="0,12,0,0">

                                <!-- Conexión y sincronización -->
                                <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,16"
                                        CornerRadius="12" BorderThickness="1">
                                    <StackPanel Margin="24">

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Text="Pokelocke Android · Firebase RTDB" FontSize="10.5"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AcentoBrush}"/>
                                            <Border Width="7" Height="7" CornerRadius="4"
                                                  Background="{DynamicResource ColorOk}"
                                                  Margin="8,3,0,0"/>
                                            <TextBlock Text="Conexión y sincronización de equipo" FontSize="16"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource ColorTexto}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Selectores y conectar -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Locke" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource ColorTextoSuave}"
                                                       Margin="0,0,0,6"/>
                                                <ComboBox x:Name="CmbLockesLocke" FontSize="13" Padding="10,8"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="Jugador" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource ColorTextoSuave}"
                                                       Margin="0,0,0,6"/>
                                                <ComboBox x:Name="CmbPlayersLocke" FontSize="13" Padding="10,8"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="⚡  Conectar en vivo"
                                                    Style="{StaticResource BotonAcento}" Padding="14,10"
                                                    FontSize="13" Margin="8,0,0,0" Click="BtnConectarLocke_Click"/>
                                        </Grid>

                                        <Border Background="{DynamicResource ColorPanelContainerLow}"
                                                BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                                CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Publicar equipo del .sav → app"
                                                               FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ColorTexto}"/>
                                                    <TextBlock Text="Las cartas, Gachapón y objetos usados en la app móvil se aplican al archivo .sav al conectar o pulsar Jugar."
                                                               FontSize="11" Foreground="{DynamicResource ColorTextoSuave}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Button Content="📤  Publicar equipo" Padding="14,10"
                                                        Style="{StaticResource BotonNav}" FontSize="12"
                                                        Click="BtnPublicarEquipo_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Registro -->
                                <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,0"
                                        CornerRadius="12" BorderThickness="1">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                    Margin="20,20,20,12">
                                            <TextBlock Text="REGISTRO" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ColorTextoSuave}"/>
                                            <Button Content="Limpiar" Margin="12,0,0,0" Padding="8,4"
                                                    FontSize="11" Click="BtnLimpiarLog_Click"
                                                    Style="{StaticResource BotonNav}"/>
                                        </StackPanel>
                                        <TextBox x:Name="TxtLogLocke" IsReadOnly="True" FontFamily="Consolas"
                                                 FontSize="11.5" Height="150" VerticalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap" Background="Transparent"
                                                 BorderThickness="0" Margin="20,0,20,20"/>
                                    </DockPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ─── PÁGINA: BIBLIOTECA DE ROMS ─── -->
                        <ScrollViewer x:Name="PanelBiblioteca" VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,0,0" Visibility="Collapsed">
                            <StackPanel Margin="0,12,0,0">

                                <!-- Cabecera de biblioteca -->
                                <Border Margin="0,0,0,16">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Mis partidas y lockes vinculados" FontSize="18"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource ColorTexto}"/>
                                            <TextBlock Text="Administra tu biblioteca de ROMs, vincula salas de Pokelocke Android y aplica cambios al guardado"
                                                       FontSize="11.5" Foreground="{DynamicResource ColorTextoSuave}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="🔄  Recargar" Padding="12,8" FontSize="12"
                                                    Click="BtnRecargar_Click" Style="{StaticResource BotonNav}"/>
                                            <Button Content="➕  Añadir ROM" Style="{StaticResource BotonAcento}"
                                                    Padding="14,10" FontSize="12" Margin="8,0,0,0"
                                                    Click="BtnAnadirRom_Click"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Métricas resumen -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource ColorPanelContainer}"
                                            BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                            CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎮" FontSize="20" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="ROMs en biblioteca" FontSize="10.5"
                                                           Foreground="{DynamicResource ColorTextoSuave}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="2 partidas" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ColorTexto}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource ColorPanelContainer}"
                                            BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                            CornerRadius="10" Padding="16" Margin="8,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔗" FontSize="20" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Lockes vinculados" FontSize="10.5"
                                                           Foreground="{DynamicResource ColorTextoSuave}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="1 activo" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AcentoBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource ColorPanelContainer}"
                                            BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                            CornerRadius="10" Padding="16" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📦" FontSize="20" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Pendiente al .sav" FontSize="10.5"
                                                           Foreground="{DynamicResource ColorTextoSuave}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="2 objetos" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ColorOk}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Split: lista ROMs + detalle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Lista de ROMs -->
                                    <Border Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Partidas registradas" FontSize="14"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource ColorTexto}"
                                                       Margin="0,0,0,12"/>

                                            <!-- ROM seleccionada -->
                                            <Border Background="{DynamicResource ColorPanelContainerHigh}"
                                                    BorderBrush="{DynamicResource AcentoBrush}" BorderThickness="1"
                                                    CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="44" Height="44" CornerRadius="8"
                                                            Background="#0B0F17" Margin="0,0,10,0">
                                                        <Image x:Name="ImgCoverSel" Stretch="UniformToFill"
                                                               Margin="2"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                        <TextBlock x:Name="TxtRomNombreSel" Text="Pokémon HeartGold"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ColorTexto}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Width="7" Height="7" CornerRadius="4"
                                                                  Background="#0B0F17" Margin="0,2,6,0"/>
                                                            <TextBlock Text="DS · Sala 607 · Hardlocke"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock Text="2026-10-11" FontSize="10.5"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        <TextBlock Text="Seleccionada" FontSize="10.5"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource AcentoBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- ROM no vinculada -->
                                            <Border Background="{DynamicResource ColorPanelContainer}"
                                                    BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                                    CornerRadius="10" Padding="14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="44" Height="44" CornerRadius="8"
                                                            Background="#0B0F17" Margin="0,0,10,0">
                                                        <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                        <TextBlock Text="Pokémon Esmeralda Kaizo"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ColorTexto}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Width="7" Height="7" CornerRadius="4"
                                                                  Background="#0B0F17" Margin="0,2,6,0"/>
                                                            <TextBlock Text="GBA · Sin locke vinculado"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock Text="2026-11-24" FontSize="10.5"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        <TextBlock Text="23:20" FontSize="10.5"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Detalle de ROM seleccionada -->
                                    <Border Grid.Column="1" Background="{DynamicResource ColorPanelContainer}"
                                            BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                            CornerRadius="12" Padding="20">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="64" Height="64" CornerRadius="10"
                                                        Background="#0B0F17" Margin="0,0,12,0"
                                                        BorderBrush="{DynamicResource ColorBordeVariant}"
                                                        BorderThickness="1">
                                                    <Image x:Name="ImgCoverDet" Stretch="UniformToFill"
                                                           Margin="2"/>
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Nintendo DS · HeartGold" FontSize="10.5"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource AcentoBrush}"
                                                               Margin="0,0,0,4"/>
                                                    <TextBlock Text="Pokémon HeartGold" FontSize="16"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource ColorTexto}"
                                                               Margin="0,0,0,6"/>
                                                    <Button Content="🖼  Cambiar carátula" Padding="8,6"
                                                            FontSize="11"
                                                            Style="{StaticResource BotonNav}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Metadatos del guardado -->
                                            <Border Background="{DynamicResource ColorPanelContainerLow}"
                                                    BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                                                    CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="Locke vinculado" FontSize="11"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        <TextBlock Text="«Hardlocke»" FontSize="12"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource AcentoBrush}"
                                                                   Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="Jugador" FontSize="11"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        <TextBlock Text="David" FontSize="12"
                                                                   Foreground="{DynamicResource ColorTexto}"
                                                                   Margin="20,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="Última partida" FontSize="11"
                                                                   Foreground="{DynamicResource ColorTextoSuave}"/>
                                                        <TextBlock Text="2026-10-11 14:04" FontSize="12"
                                                                   FontFamily="Consolas" Foreground="{DynamicResource ColorTexto}"
                                                                   Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <Border BorderBrush="{DynamicResource ColorBordeVariant}"
                                                            BorderThickness="0,1,0,0" Margin="8,8,0,8"/>
                                                    <TextBlock Text="Archivo de guardado (.sav)" FontSize="11"
                                                               Foreground="{DynamicResource ColorTextoSuave}"/>
                                                    <TextBlock Text="E:\Nintendo\Pokemon\HeartGold\HeartGold_rand.dsv"
                                                               FontSize="11" FontFamily="Consolas"
                                                               Foreground="{DynamicResource ColorTexto}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Botón jugar -->
                                            <Button x:Name="BtnJugar" Content="▶  Jugar ahora"
                                                    Style="{StaticResource BotonAcento}" Padding="16,12"
                                                    FontSize="13" FontWeight="SemiBold"
                                                    Margin="0,0,0,12"/>

                                            <!-- Acciones secundarias (grid 2x2) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Content="🔗  Vincular a locke"
                                                        Padding="10,8" FontSize="11.5" Margin="0,0,6,0"
                                                        Click="BtnVincularLocke_Click" Style="{StaticResource BotonNav}"/>
                                                <Button Grid.Column="1" Content="📤  Publicar equipo"
                                                        Padding="10,8" FontSize="11.5" Margin="6,0,0,0"
                                                        Click="BtnPublicarEquipo_Click" Style="{StaticResource BotonNav}"/>

                                                <Button Grid.Column="0" Content="🐚  Escamas Corazón"
                                                        Padding="10,8" FontSize="11.5" Margin="0,8,6,0"
                                                        Click="BtnEscamasCorazon_Click" Style="{StaticResource BotonNav}"/>
                                                <Button Grid.Column="1" Content="🍬  Carameloraros"
                                                        Padding="10,8" FontSize="11.5" Margin="6,8,0,0"
                                                        Click="BtnCarameloraros_Click" Style="{StaticResource BotonNav}"/>
                                            </Grid>

                                            <!-- Borrar -->
                                            <Button Content="🗑  Borrar de la biblioteca"
                                                    Padding="10,6" FontSize="11.5" Margin="0,12,0,0"
                                                    Foreground="{DynamicResource ColorError}"
                                                    Background="Transparent" BorderBrush="Transparent"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ─── PÁGINA: RANDOMIZADOR ─── -->
                        <Grid x:Name="PanelRandomizador" Margin="0,12,0,0" Visibility="Collapsed">
                            <ui:RandomizadorControl x:Name="CtrlRandomizador"/>
                        </Grid>

                        <!-- ─── PÁGINA: AJUSTES ─── -->
                        <Grid x:Name="PanelAjustes" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
