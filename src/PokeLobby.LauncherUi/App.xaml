<Application x:Class="PokeLobby.LauncherUi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ═══════════ Paleta Material Design 3 (estilo Rediseño HTML) ═══════════ -->
        <SolidColorBrush x:Key="ColorFondo" Color="#0F131E"/>
        <SolidColorBrush x:Key="ColorPanel" Color="#1B1F2B"/>
        <SolidColorBrush x:Key="ColorPanelVelo" Color="#E6181D2A"/>
        <SolidColorBrush x:Key="ColorPanelSolido" Color="#1B1F2B"/>
        <SolidColorBrush x:Key="ColorPanelVeloBajo" Color="#0A0E19"/>
        <SolidColorBrush x:Key="ColorPanelVeloBajo2" Color="#171B26"/>
        <SolidColorBrush x:Key="ColorPanelContainer" Color="#1B1F2B"/>
        <SolidColorBrush x:Key="ColorPanelContainerLow" Color="#171B26"/>
        <SolidColorBrush x:Key="ColorPanelContainerLowest" Color="#0A0E19"/>
        <SolidColorBrush x:Key="ColorPanelContainerHigh" Color="#262A35"/>
        <SolidColorBrush x:Key="ColorPanelContainerHighest" Color="#313441"/>
        <SolidColorBrush x:Key="ColorBorde" Color="#5A5E6B"/>
        <SolidColorBrush x:Key="ColorBordeVariant" Color="#2C303C"/>
        <SolidColorBrush x:Key="ColorTexto" Color="#DFE2F2"/>
        <SolidColorBrush x:Key="ColorTextoSuave" Color="#A7ABBA"/>
        <SolidColorBrush x:Key="ColorTextoMuted" Color="#A7ABBA"/>

    <!-- Tooltips legibles en TODA la app: fondo oscuro + letra clara. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ColorPanel}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

        <SolidColorBrush x:Key="ColorOk" Color="#4AE176"/>
        <SolidColorBrush x:Key="ColorAviso" Color="#FFB95F"/>
        <SolidColorBrush x:Key="ColorError" Color="#FFB4AB"/>

        <!-- Acento principal (coral/salmon del rediseño) -->
        <SolidColorBrush x:Key="AcentoBrush" Color="#FFB4A8"/>
        <SolidColorBrush x:Key="AcentoContainerBrush" Color="#FF5541"/>
        <SolidColorBrush x:Key="AcentoSuaveBrush" Color="#30FFB4A8"/>
        <SolidColorBrush x:Key="AcentoBordeBrush" Color="#A0FFB4A8"/>
        <LinearGradientBrush x:Key="AcentoGradienteBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFB4A8" Offset="0"/>
            <GradientStop Color="#FF5541" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="FondoVeloBrush" Color="Transparent"/>

        <!-- ═══════════ Botones ═══════════ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#232A3D"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorde}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E364D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BotonAcento" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AcentoBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AcentoBordeBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BotonNav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextoSuave}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AcentoSuaveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="activo">
                                <Setter Property="Background" Value="{DynamicResource AcentoSuaveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AcentoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón "Aplicar cambios al .sav": contorno de botón (fondo transparente, borde visible) -->
        <Style TargetType="Button" x:Key="BotonAplicarCambios" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E364D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón enlace (p. ej. "Ver todas ›"): texto azul, sin fondo ni borde -->
        <Style TargetType="Button" x:Key="BotonEnlaceAzul" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#4AA3FF"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#7FBFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ Tarjetas y textos ═══════════ -->
        <Style TargetType="Border" x:Key="Tarjeta">
            <Setter Property="Background" Value="{DynamicResource ColorPanelVelo}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TituloSeccion">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextoSuave}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="EtiquetaCampo">
            <Setter Property="Foreground" Value="{DynamicResource ColorTextoSuave}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
        </Style>

        <!-- ═══════════ Entradas ═══════════ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#121723"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorde}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════ Desplegables (ComboBox) — texto legible en todas las pantallas ═══════════
             Causa del fallo anterior: la plantilla por defecto de WPF pinta el Popup con el color
             del sistema (blanco) mientras el texto heredaba el tema oscuro. Aquí se define la
             plantilla completa: caja, flecha, popup oscuro, ítems con hover/seleccionado/foco/
             deshabilitado y desplazamiento. -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="Background" Value="#121723"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorde}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBoton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Caja" Background="#121723"
                                                BorderBrush="{DynamicResource ColorBorde}" BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L5,5 10,0" Stroke="{DynamicResource ColorTextoSuave}"
                                                      StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource AcentoBordeBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource AcentoBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Caja" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContenidoSeleccion" IsHitTestVisible="False"
                                              Margin="9,0,28,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              TextElement.Foreground="{DynamicResource ColorTexto}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource ColorPanel}"
                                        BorderBrush="{DynamicResource AcentoBordeBrush}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0" Padding="4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ítems del desplegable: fondo oscuro, hover/acento y deshabilitado legibles -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Fila" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter TextElement.Foreground="{DynamicResource ColorTexto}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Fila" Property="Background" Value="{DynamicResource AcentoSuaveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fila" Property="Background" Value="{DynamicResource AcentoBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="CheckBorder" Background="#121723"
                                        BorderBrush="{DynamicResource ColorBorde}" BorderThickness="1"
                                        CornerRadius="3" Width="18" Height="18"
                                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Path x:Name="CheckMark" Data="M2,6 L5,9 L8,3"
                                      Stroke="{DynamicResource AcentoBrush}" StrokeThickness="2.5"
                                      Width="10" Height="10" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AcentoBrush}"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AcentoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AcentoBordeBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="RadioBorder" Background="#121723"
                                        BorderBrush="{DynamicResource ColorBorde}" BorderThickness="1.5"
                                        CornerRadius="9" Width="18" Height="18"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="RadioMark" Fill="{DynamicResource AcentoBrush}"
                                             Width="10" Height="10" Visibility="Collapsed"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{DynamicResource AcentoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{DynamicResource AcentoBordeBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" CornerRadius="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AcentoSuaveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AcentoBrush}"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource ColorBorde}"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <!-- Pestañas de categoría (estilo Rediseño: botón toggle) -->
        <Style TargetType="Button" x:Key="BotonCategoria">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextoSuave}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBordeVariant}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Background"
                                        Value="{DynamicResource ColorPanelVelo}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="activo">
                                <Setter TargetName="Borde" Property="BorderBrush"
                                        Value="{DynamicResource AcentoBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>