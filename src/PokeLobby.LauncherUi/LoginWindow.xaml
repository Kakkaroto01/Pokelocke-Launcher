<Window x:Class="PokeLobby.LauncherUi.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuenta PokeLocke" Width="480" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ColorFondo}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Grid Margin="24">
        <Border Background="{DynamicResource ColorPanelContainer}" CornerRadius="16"
                BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="1"
                Padding="28">
            <StackPanel>

                <!-- Cabecera: badge Firebase + cerrar -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource ColorOk}" Opacity="0.18"
                            CornerRadius="999" Padding="10,4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource ColorOk}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Firebase RTDB" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorOk}"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="1" Content="✕" Width="30" Height="30"
                            FontSize="12" Padding="0" Cursor="Hand"
                            Style="{StaticResource BotonNav}"
                            Click="Cerrar_Click"
                            ToolTip="Cancelar"/>
                </Grid>

                <!-- Título -->
                <TextBlock Text="Cuenta PokeLocke" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorTexto}"/>
                <TextBlock Text="Entra con el mismo usuario y contraseña de la app Android."
                           FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorTextoSuave}"
                           Margin="0,4,0,18"/>

                <!-- Usuario -->
                <TextBlock Text="Usuario" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorTexto}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsuario" Padding="10,9" FontSize="13"
                         TextChanged="Credenciales_Changed"/>

                <!-- Contraseña (PasswordBox + TextBox para mostrar/ocultar) -->
                <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorTexto}" Margin="0,14,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="TxtPassword" Grid.Column="0" Padding="10,9" FontSize="13"
                                 PasswordChanged="Password_PasswordChanged"/>
                    <TextBox x:Name="TxtPasswordVisible" Grid.Column="0" Padding="10,9" FontSize="13"
                             Visibility="Collapsed" TextChanged="PasswordVisible_TextChanged"/>

                    <Button Grid.Column="1" x:Name="BtnVerPassword" Content="👁"
                            Width="34" FontSize="13" Margin="8,0,0,0" Padding="0"
                            Style="{StaticResource BotonNav}"
                            Click="VerPassword_Click"
                            ToolTip="Mostrar u ocultar contraseña"/>
                </Grid>

                <!-- Error -->
                <TextBlock x:Name="TxtError" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorError}"
                           Margin="0,12,0,0" Visibility="Collapsed"/>

                <!-- Botones -->
                <Button x:Name="BtnEntrar" Content="Iniciar sesión"
                        Style="{StaticResource BotonAcento}"
                        Padding="16,11" FontSize="13.5" FontWeight="SemiBold"
                        Margin="0,20,0,0" Click="Entrar_Click"/>
                <Button x:Name="BtnCrear" Content="Crear cuenta nueva"
                        Style="{StaticResource BotonNav}"
                        Padding="16,10" FontSize="13"
                        Margin="0,10,0,0" Click="Crear_Click"/>

                <!-- Nota -->
                <Border BorderBrush="{DynamicResource ColorBordeVariant}" BorderThickness="0,1,0,0"
                        Margin="0,20,0,0" Padding="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="☁" FontSize="12" Margin="0,0,8,0"
                                   Foreground="{DynamicResource ColorTextoSuave}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Tu sesión se vincula con Pokelocke Android y se guarda en Roaming."
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorTextoSuave}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
